# The MERN backend (camera-b). Start it with: npm run dev
# Leave this UNSET to run the host UI against the in-memory mock instead —
# that's what the Vercel deploy does, since it has no backend yet.
VITE_API_URL=http://localhost:5000/api

# Force the mock even when VITE_API_URL is set. Handy for UI work offline.
# VITE_MOCK_API=true

# Legacy — the old mock services read these. Unused by the host app.
VITE_FIREBASE_API_KEY=your_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=pov_events
